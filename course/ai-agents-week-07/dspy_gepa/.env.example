#
# Since most our projects will need the configuration
# utility, this fixes the directory where to find them.
#
export BOOTCAMP_ROOT_DIR="<path_to_your_project_root_dir>"

#
# Precaution, needed for some IDEs
# to recognize that the main svlearn library code
# is in the src/ sub-directory
#
export PYTHONPATH="<path_to_your_project_root_dir>/src"

#
# api keys
#
export OPENAI_API_KEY="<openai_api_key>"

#
# LLM backend. "supportvectors" uses the SV cluster; any other value
# (including "openai") uses hosted OpenAI and OPENAI_API_KEY above.
#
export LLM_PROVIDER="openai"

# Used only when LLM_PROVIDER=supportvectors. Both models share SV_API_BASE.
# export SV_API_BASE="http://10.0.10.70:8000/v1"
# export SV_MODEL="openai/openai/gpt-oss-20b"          # task model (gpt-5-mini analog)
# export SV_STRONG_MODEL="openai/openai/gpt-oss-120b"  # stronger model (gpt-5 analog)
# export SV_API_KEY="not-needed"
