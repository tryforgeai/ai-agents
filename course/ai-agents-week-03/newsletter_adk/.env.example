#
# Since most our projects will need the configuration
# utility, this fixes the directory where to find them.
#
export BOOTCAMP_ROOT_DIR="/home/devops/shubeeksh/ai_agents_bootcamp/news_summarization_spec_google_adk"

#
# Project's Python executable path
# Points to the virtual environment's Python interpreter
#
export PROJECT_PYTHON="/home/devops/shubeeksh/ai_agents_bootcamp/news_summarization_spec_google_adk/.venv/bin/python"

#
# Precaution, needed for some IDEs
# to recognize that the main svlearn library code
# is in the src/ sub-directory
#
export PYTHONPATH="/home/devops/shubeeksh/ai_agents_bootcamp/news_summarization_spec_google_adk/src"

# The OpenAI Key (Replace with your own key)
export OPENAI_API_KEY=""

# News APIs
#    - Serper (search): https://serper.dev/
#    - NewsAPI:         https://newsapi.org/
#    - NewsData.io:     https://newsdata.io/
#    - Mediastack:      https://mediastack.com/
export SERPER_API_KEY=""
export NEWSAPI_API_KEY=""
export NEWSDATA_API_KEY=""
export MEDIASTACK_API_KEY=""

# =============================================================================
# LLM — uncomment EXACTLY ONE provider line (last uncommented wins if several)
# Then ensure that provider's model / key lines below are also uncommented.
# Restart `adk web` after changing.
# =============================================================================

# --- PROVIDER (uncomment one) ---
export NEWSLETTER_LLM_PROVIDER="local"
# export NEWSLETTER_LLM_PROVIDER="openai"
# export NEWSLETTER_LLM_PROVIDER="openrouter"

# --- LOCAL (self-hosted gpt-oss-20b) ---
export NEWSLETTER_LOCAL_MODEL="openai/openai/gpt-oss-20b"
export NEWSLETTER_API_BASE="http://10.0.10.70:8000/v1"
export NEWSLETTER_API_KEY="dummy"

# --- OPENAI (uses OPENAI_API_KEY above) ---
export NEWSLETTER_OPENAI_MODEL="gpt-4o-mini"
# export NEWSLETTER_OPENAI_MODEL="gpt-4o"
# export NEWSLETTER_OPENAI_MODEL="gpt-4.1-mini"

# --- OPENROUTER ---
# export OPENROUTER_API_KEY="sk-or-v1-..."
