#
# Since most our projects will need the configuration
# utility, this fixes the directory where to find them.
#
export BOOTCAMP_ROOT_DIR="/home/devops/shubeeksh/test/newsletter-langgraph"

#
# Project's Python executable path
# Points to the virtual environment's Python interpreter
#
export PROJECT_PYTHON="/home/devops/shubeeksh/test/newsletter-langgraph/.venv/bin/python"

#
# Precaution, needed for some IDEs
# to recognize that the main svlearn library code
# is in the src/ sub-directory
#
export PYTHONPATH="/home/devops/shubeeksh/test/newsletter-langgraph/src"

# =====

# The OpenAI Key (Replace with your own key)
export OPENAI_API_KEY=""

export SERPER_API_KEY= ""

# OpenAI-compatible local model endpoint
export OPENAI_BASE_URL="http://10.0.10.70:8000/v1"
export OPENAI_MODEL="openai/gpt-oss-20b"
