#
# Since most our projects will need the configuration
# utility, this fixes the directory where to find them.
#
export BOOTCAMP_ROOT_DIR="/home/chandar/llm_bootcamp_curriculum/topics/prompt_engineering"

#
# Precaution, needed for some IDEs
# to recognize that the main svlearn library code
# is in the src/ sub-directory
#
export PYTHONPATH="/home/chandar/llm_bootcamp_curriculum/topics/prompt_engineering/src"

#
# SupportVectors cluster OpenAI-compatible endpoint.
# Requires WireGuard access to the SV network.
#
export OPENAI_BASE_URL="http://10.0.10.70:8000/v1"

# LiteLLM reads this name; keep it the same as OPENAI_BASE_URL.
export OPENAI_API_BASE="http://10.0.10.70:8000/v1"

#
# Dummy key. The cluster does not validate a real OpenAI key.
#
export OPENAI_API_KEY="sk-dummy"
