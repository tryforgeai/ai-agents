#
# Since most our projects will need the configuration
# utility, this fixes the directory where to find them.
#
export BOOTCAMP_ROOT_DIR="/home/devops/shubeeksh/ai_agents_bootcamp/news_summarization_spec_google_adk"

#
# Project's Python executable path
# Points to the virtual environment's Python interpreter
#
export PROJECT_PYTHON="/home/devops/shubeeksh/ai_agents_bootcamp/news_summarization_spec_google_adk/.venv/bin/python"

#
# Precaution, needed for some IDEs
# to recognize that the main svlearn library code
# is in the src/ sub-directory
#
export PYTHONPATH="/home/devops/shubeeksh/ai_agents_bootcamp/news_summarization_spec_google_adk/src"


export OPENAI_API_KEY=

# ------------------------------------------------------------------
# MCP Resource Server with Google OAuth
# ------------------------------------------------------------------

# Base URL of your MCP Resource Server (must be reachable by clients)
RS_BASE_URL=http://localhost:8026

# Where to bind the local server
RS_HOST=0.0.0.0
RS_PORT=8026

# Path where MCP endpoint is mounted
MCP_PATH=/mcp

# Google OAuth client credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect path you registered in Google Cloud OAuth credentials
GOOGLE_REDIRECT_PATH=/auth/callback

# Required OAuth scopes (space-separated list)
REQUIRED_SCOPES=openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile

# Allowed client redirect URIs for DCR (semicolon-separated list)
ALLOWED_CLIENT_REDIRECT_URIS=http://localhost:*;http://127.0.0.1:*
