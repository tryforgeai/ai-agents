# 此文件只提供示例；库不会自动加载 .env。
# 使用 shell export，或在应用入口自行调用 load_dotenv。
ADK_MODEL=gpt-4o-mini
# OPENAI_API_KEY=填写你自己的密钥

# OpenAI-compatible 服务：模型标识必须符合服务端配置。
# ADK_MODEL=openai/your-model
# ADK_API_BASE=http://127.0.0.1:8000/v1
# ADK_API_KEY=not-needed

# MCP 示例需要独立启动 Streamable HTTP MCP 服务。
MCP_URL=http://127.0.0.1:9000/mcp
